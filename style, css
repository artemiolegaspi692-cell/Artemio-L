
* {
 box-sizing: border-box;
}

body {
 margin: 0;
 font-family: Arial, sans-serif;
 background: #f1f5f9;
 color: #172033;
}

header {
 background: #142b4a;
 color: white;
 padding: 22px 18px;
 border-radius: 0 0 18px 18px;
}

header h2 {
 margin: 0 0 6px;
}

header p {
 margin: 0;
 color: #cbd5e1;
 font-size: 13px;
}

.container {
 padding: 16px;
 max-width: 850px;
 margin: auto;
}

.stats {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 12px;
}

.card {
 background: white;
 padding: 17px;
 border-radius: 13px;
 box-shadow: 0 2px 8px #0000000d;
 margin-bottom: 14px;
}

.stat {
 font-size: 27px;
 font-weight: bold;
 margin-top: 8px;
}

.blue {
 color: #2563eb;
}

.green {
 color: #16a34a;
}

.orange {
 color: #ea580c;
}

.red {
 color: #dc2626;
}

h3 {
 margin-top: 0;
}

input, select, button {
 width: 100%;
 padding: 12px;
 margin: 6px 0;
 border-radius: 8px;
 border: 1px solid #cbd5e1;
 font-size: 15px;
}

button {
 background: #2563eb;
 color: white;
 border: 0;
 font-weight: bold;
 cursor: pointer;
}

button.greenbtn {
 background: #15803d;
}

button.darkbtn {
 background: #142b4a;
}

.employee {
 border: 1px solid #e2e8f0;
 padding: 12px;
 border-radius: 10px;
 margin-top: 10px;
}

.employee small {
 color: #64748b;
}

#qrcode {
 display: flex;
 justify-content: center;
 padding: 12px;
}

#reader {
 width: 100%;
 overflow: hidden;
}

table {
 width: 100%;
 border-collapse: collapse;
 font-size: 13px;
}

td, th {
 padding: 10px 5px;
 border-bottom: 1px solid #e2e8f0;
 text-align: left;
}

.note {
 font-size: 12px;
 color: #64748b;
 line-height: 1.5;
}
